# =============================================================================
# Ghostty Configuration - Light Mode with Apple System Colors
# XDG-compliant config in ~/.config/ghostty/
# =============================================================================

# =============================================================================
# Typography - Apple's SF Mono
# =============================================================================

# Primary font settings - larger text for big monitor + comfort
font-family = SF Mono
font-size = 14

# Font variants (specify per-style fonts)
# font-family-bold = SF Mono Bold
# font-family-italic = SF Mono Italic
# font-family-bold-italic = SF Mono Bold Italic

# =============================================================================
# Hardcore High‑Contrast Light Theme (Apple System Colors)
# =============================================================================

# Maximum contrast: pure black text on pure white background
background = #ffffff
foreground = #000000

# Make the cursor extremely visible (red on white)
cursor-color = #ff3b30
# Keep the cursor text dark so it never disappears
cursor-text = #000000

# High‑contrast selection (blue fill, white text)
selection-background = #007aff
selection-foreground = #ffffff

# ANSI Colors - Apple System Colors palette (high-contrast tweaks)
# These are mapped to ensure no “dim” or “bright black” text becomes hard to read.
# Use pure black for both standard and bright black for maximum contrast.
palette = 0=#000000
palette = 1=#ff3b30
palette = 2=#34c759
palette = 3=#ff9500
palette = 4=#007aff
palette = 5=#af52de
palette = 6=#00c7d4
# Use solid black for ANSI bright white to avoid invisibility on white bg.
palette = 7=#000000
palette = 8=#000000
palette = 9=#ff3b30
palette = 10=#34c759
palette = 11=#ff9500
palette = 12=#007aff
palette = 13=#af52de
palette = 14=#00c7d4
palette = 15=#000000

# Force the 256-color gray ramp to be dark so any “dim”/“faint” text remains readable.
# This covers common prompt themes that use 244–255 for low-contrast status info.
palette = 232=#000000
palette = 233=#000000
palette = 234=#000000
palette = 235=#000000
palette = 236=#000000
palette = 237=#000000
palette = 238=#000000
palette = 239=#000000
palette = 240=#000000
palette = 241=#000000
palette = 242=#000000
palette = 243=#000000
palette = 244=#000000
palette = 245=#000000
palette = 246=#000000
palette = 247=#000000
palette = 248=#000000
palette = 249=#000000
palette = 250=#000000
palette = 251=#000000
palette = 252=#000000
palette = 253=#000000
palette = 254=#000000
palette = 255=#000000


# =============================================================================
# Window & Behavior - Minimal Apple Aesthetic
# =============================================================================

# Window decoration - maximize contrast / reduce distraction
window-decoration = client
macos-titlebar-style = transparent
# Hardcore mode: fully opaque solid background
background-opacity = 1.0
background-blur-radius = 0

# Keep splits fully visible (no fading) for maximum contrast
unfocused-split-opacity = 1.0

# macOS-specific: Use Option key as Alt (common in terminals)
# Uncomment if needed:
# macos-option-as-alt = true

# =============================================================================
# Visual Effects & Polish
# =============================================================================

# The screenshot look depends more on translucency than heavy shader effects.

# =============================================================================
# Keyboard Shortcuts - Minimal Override
# =============================================================================

# Open config with ⌘+,
keybind = super+comma=open_config

# Reload config with ⌘+Shift+,
keybind = super+shift+comma=reload_config

# =============================================================================
# Shell Integration (Optional - for advanced features)
# =============================================================================

# Uncomment to enable shell integration (requires compatible shell config)
# shell-integration = true
