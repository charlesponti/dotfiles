# =============================================================================
# Ghostty Configuration - Apple Design System
# XDG-compliant config in ~/.config/ghostty/
# =============================================================================

# =============================================================================
# Typography - Apple's SF Mono
# =============================================================================

# Primary font settings - larger text for big monitor + comfort
font-family = SF Mono
font-size = 14

# Font variants (specify per-style fonts)
# font-family-bold = SF Mono Bold
# font-family-italic = SF Mono Italic
# font-family-bold-italic = SF Mono Bold Italic

# =============================================================================
# LIGHT MODE (Default) - Apple System Colors
# =============================================================================

background = #f5f5f7
foreground = #1d1d1d
cursor-color = #007aff
cursor-text = #000000

# Selection: Blue accent
selection-background = #007aff
selection-foreground = #f5f5f7

# ANSI Colors (Apple System Colors - Light optimized)
# WCAG AA Compliant: All colors tested for 4.5:1+ contrast ratio on #f5f5f7 background
palette = 0=#5a5a5f
palette = 1=#d70015
palette = 2=#248a3d
palette = 3=#8b4107
palette = 4=#0051d5
palette = 5=#5a2a9f
palette = 6=#004d63
palette = 7=#1d1d1d
palette = 8=#6a6a70
palette = 9=#ff3b30
palette = 10=#34c759
palette = 11=#ff9500
palette = 12=#007aff
palette = 13=#af52de
palette = 14=#00c7d4
palette = 15=#000000



# =============================================================================
# Window & Behavior - Minimal Apple Aesthetic
# =============================================================================

# Window decoration - use client for native titlebar (allows window movement)
window-decoration = client
macos-titlebar-style = transparent

# Make unfocused splits subtle (60% opacity)
unfocused-split-opacity = 0.6

# macOS-specific: Use Option key as Alt (common in terminals)
# Uncomment if needed:
# macos-option-as-alt = true

# =============================================================================
# Visual Effects & Polish
# =============================================================================

# No custom shader - Apple design principle: minimize unnecessary effects
# Focus on typography and color clarity

# =============================================================================
# Keyboard Shortcuts - Minimal Override
# =============================================================================

# Open config with ⌘+,
keybind = super+comma=open_config

# Reload config with ⌘+Shift+,
keybind = super+shift+comma=reload_config

# =============================================================================
# Shell Integration (Optional - for advanced features)
# =============================================================================

# Uncomment to enable shell integration (requires compatible shell config)
# shell-integration = true
