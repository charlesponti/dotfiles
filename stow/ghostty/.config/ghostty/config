# =============================================================================
# Ghostty Configuration - Hermès Sellier
# Deep leather, signature orange, warm ivory — the house aesthetic.
# =============================================================================

# =============================================================================
# Typography
# =============================================================================

font-family = SF Mono
font-size = 13
font-feature = -calt, -liga, -dlig
adjust-cell-height = 8%
adjust-font-baseline = -1

# =============================================================================
# Theme
# =============================================================================

# Hermès orange:    #E8650A  (Pantone 165 C — the box, the brand)
# Leather dark:     #17100A  (selle / interior of a Birkin)
# Warm ivory:       #F2E4CC  (Toile H, scarves)
# Saddle gold:      #C4832C  (hardware, buckles)
background = #17100A
foreground = #F2E4CC
bold-color = bright
minimum-contrast = 2.5

# Cursor = signature orange bar — always on brand
cursor-color = #E8650A
cursor-text = #17100A
cursor-style = bar
cursor-style-blink = false

# Selection: deep saddle leather
selection-background = #4D2A0A
selection-foreground = #F2E4CC

# Search: saffron highlight / gold selected
search-background = #C4832C
search-foreground = #17100A
search-selected-background = #E8650A
search-selected-foreground = #17100A

# -------------------------------------------------------
# ANSI Palette — Hermès house palette
# -------------------------------------------------------
# Normal
palette = 0=#17100A
palette = 1=#B8391E
palette = 2=#6E8030
palette = 3=#C4832C
palette = 4=#4E6882
palette = 5=#8C5030
palette = 6=#5A7C6A
palette = 7=#D8C8A4
# Bright
palette = 8=#3D2010
palette = 9=#E8650A
palette = 10=#96A848
palette = 11=#E8A830
palette = 12=#7090A8
palette = 13=#C47840
palette = 14=#7AA890
palette = 15=#F5EBD5

palette-generate = true

# =============================================================================
# Window & Layout
# =============================================================================

window-decoration = client
macos-titlebar-style = transparent
macos-window-shadow = true
# Fully opaque — leather objects don't fade at the edges
background-opacity = 1.0
background-blur = false
unfocused-split-opacity = 0.88
# Orange Hermès divider on splits
split-divider-color = #E8650A
# Generous marges — maison-quality whitespace
window-padding-x = 16
window-padding-y = 14
window-padding-balance = true
window-padding-color = background
scrollbar = never
window-save-state = always

# =============================================================================
# Selection, Links, and Comfort
# =============================================================================

copy-on-select = clipboard
selection-clear-on-copy = true
mouse-hide-while-typing = true
link-url = true
link-previews = osc8

# =============================================================================
# Shell Integration
# =============================================================================

shell-integration = detect
shell-integration-features = cursor,title,path,ssh-env,ssh-terminfo

# =============================================================================
# Command Palette / Quick Terminal
# =============================================================================

quick-terminal-position = bottom
quick-terminal-size = 28%
quick-terminal-autohide = true
keybind = f12=toggle_quick_terminal

# =============================================================================
# Keyboard Shortcuts
# =============================================================================

keybind = super+comma=open_config
keybind = super+shift+comma=reload_config

# =============================================================================
# macOS Convenience
# =============================================================================

macos-option-as-alt = true
macos-auto-secure-input = true
macos-secure-input-indication = true
