{
  "diff_view_style": "unified",
  "cli_default_open_behavior": "new_window",
  "agent": {
    "tool_permissions": {
      "tools": {
        "skill": {
          "default": "allow"
        },
        "create_directory": {
          "default": "allow",
        },
        "terminal": {
          "default": "allow",
        },
      },
    },
    "default_model": {
      "effort": "medium",
      "provider": "copilot_chat",
      "model": "gpt-5.4-mini",
      "enable_thinking": true,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "medium",
        "model": "gpt-5.4-mini",
      },
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "bypassPermissions",
        "model": "default",
      },
      "type": "registry",
    },
    "github-copilot-cli": {
      "default_config_options": {
        "allow_all": "on",
        "model": "gpt-5.4-mini",
      },
      "favorite_config_option_values": {
        "model": ["gpt-5.4", "gpt-5.4-mini"],
      },
      "type": "registry",
    },
  },
  "auto_install_extensions": {
    "dockerfile": true,
    "github-actions": true,
    "make": true,
    "oxc": true,
    "rainbow-csv": true,
    "seti-icons": true,
    "svelte": true,
    "swift": true,
    "zig": true,
  },
  "base_keymap": "VSCode",
  "buffer_font_family": "SF Mono",
  "buffer_font_size": 11,
  "colorize_brackets": true,
  "current_line_highlight": "all",
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/.git/objects/**",
    "**/.git/subtree-cache/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.cache/**",
    "**/.tsbuildinfo",
    "**/.turbo/**",
    "**/.react-router/cache/**",
    "**/.next/**",
    "**/.output/**",
    "**/.vercel/**",
    "**/.netlify/**",
    "**/.svelte-kit/**",
    "**/coverage/**",
    "**/__pycache__/**",
    "**/.ruff_cache/**",
    "**/.mypy_cache/**",
  ],
  "formatter": {
    "external": {
      "command": "oxfmt",
      "arguments": ["--stdin-filepath", "{buffer_path}"]
    }
  },
  "languages": {
    "Go": {
      "formatter": {
        "external": {
          "command": "gofmt",
          "arguments": []
        }
      }
    },
  },
  "tab_size": 2,
  "hard_tabs": false,
  "file_types": {
    "tailwindcss": ["*.css"],
    "GitHub Actions": [".github/workflows/*.yml", ".github/workflows/*.yaml"],
  },
  "git_panel": {
    "tree_view": true,
  },
  "gutter": {
    "line_numbers": true,
  },
  "icon_theme": "Catppuccin Frappé",
  "inlay_hints": {
    "enabled": false,
    "show_type_hints": false,
    "show_parameter_hints": false,
    "show_other_hints": false,
  },
  "lsp": {
    "basedpyright": {
      "settings": {
        "basedpyright.analysis": {
          "typeCheckingMode": "standard",
        },
      },
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "format_on_save": "on",
  "preferred_line_length": 100,
  "session": {
    "trust_all_worktrees": true,
  },
  "show_whitespaces": "selection",
  "soft_wrap": "bounded",
  "terminal": {
    "cursor_shape": "bar",
    "font_family": "SF Mono",
    "max_scroll_history_lines": 100000,
    "shell": {
      "program": "/bin/zsh",
    },
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Ayu Dark",
  },
  "ui_font_size": 16,
}
